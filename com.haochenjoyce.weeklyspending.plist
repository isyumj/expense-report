<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.haochenjoyce.weeklyspending</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/joyceyu/Developer/notion_weekly_report/.venv/bin/python3</string>
        <string>/Users/joyceyu/Developer/notion_weekly_report/spending_report.py</string>
    </array>

    <!-- Run every Monday at 10:00 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Log stdout/stderr so you can debug -->
    <key>StandardOutPath</key>
    <string>/tmp/spending_report.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/spending_report_error.log</string>

    <!-- Auto-restart on crash -->
    <key>KeepAlive</key>
    <false/>

    <!-- Run even if missed (e.g. Mac was asleep) — triggers on next login -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
